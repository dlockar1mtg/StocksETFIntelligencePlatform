{
  "phase": "3",
  "subphase": "3.6",
  "policy_version": "1.0.0",
  "name": "Benchmark Authority and Relative-Return Engine",
  "objective": "Authorize governed benchmark assignment and excess total-return calculation across the UIP horizon contract without granting risk, forecasting, ranking, recommendation, allocation, export, or execution authority.",
  "uip_horizon_contract": ["30d", "90d", "180d", "1y", "3y", "5y"],
  "required_return_basis": "ADJUSTED_CLOSE_TOTAL_RETURN",
  "benchmark_states": ["BENCHMARK_ASSIGNED", "BENCHMARK_UNASSIGNED", "BENCHMARK_UNSUPPORTED", "BENCHMARK_BLOCKED"],
  "comparison_states": ["RELATIVE_RETURN_CALCULATED", "RELATIVE_RETURN_NOT_AUTHORIZED", "RELATIVE_RETURN_BLOCKED"],
  "benchmark_classes": [
    "US_BROAD_MARKET",
    "US_LARGE_CAP",
    "US_GROWTH",
    "US_VALUE",
    "US_DIVIDEND",
    "US_SECTOR",
    "US_SMALL_CAP",
    "INTERNATIONAL_DEVELOPED",
    "EMERGING_MARKETS",
    "FIXED_INCOME",
    "REAL_ASSETS",
    "COMMODITY",
    "SPECIALIZED",
    "UNASSIGNED"
  ],
  "controls": {
    "stable_benchmark_security_id_required": true,
    "ticker_only_benchmark_identity_prohibited": true,
    "taxonomy_evidence_required": true,
    "same_return_basis_required": true,
    "same_horizon_required": true,
    "same_start_date_required": true,
    "same_end_date_required": true,
    "missing_benchmark_must_not_be_imputed": true,
    "unsupported_comparisons_preserved": true,
    "self_benchmark_comparison_allowed": false,
    "excess_return_formula": "asset_cumulative_total_return_minus_benchmark_cumulative_total_return"
  },
  "authority": {
    "benchmark_assignment": true,
    "benchmark_comparison": true,
    "relative_return_calculation": true,
    "risk_analytics": false,
    "forecasting": false,
    "ranking": false,
    "recommendations": false,
    "portfolio_allocation": false,
    "uip_export": false,
    "automatic_execution": false,
    "direct_uip_database_writes": false
  },
  "fail_closed": true
}
