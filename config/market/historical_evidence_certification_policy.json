{
  "phase": "3",
  "subphase": "3.4",
  "policy_version": "1.0.0",
  "name": "Historical Evidence Certification and Analytics Eligibility",
  "objective": "Certify the completed historical evidence for all 3462 Phase 3 ETFs and assign non-destructive per-horizon analytics eligibility without yet authorizing return or risk calculations.",
  "required_record_count": 3462,
  "required_collection_status": "COLLECTED",
  "required_provider_id": "YAHOO_FINANCE_CHART",
  "required_provider_data_granularity": "1d",
  "required_seed_symbols": ["VOO", "SCHD", "QQQM"],
  "horizon_minimum_observations": {
    "1m": 21,
    "3m": 63,
    "1y": 252,
    "3y": 756,
    "5y": 1260
  },
  "evidence_controls": {
    "raw_payload_required": true,
    "payload_sha256_reconciliation_required": true,
    "provider_symbol_match_required": true,
    "daily_granularity_required": true,
    "chronological_order_required": true,
    "duplicate_observation_dates_block": true,
    "future_observation_dates_block": true,
    "latest_observation_max_age_days": 7,
    "adjusted_price_coverage_required": true,
    "null_adjusted_prices_block": true,
    "corporate_action_event_shapes_required": true,
    "missing_evidence_must_not_be_imputed": true
  },
  "record_states": [
    "EVIDENCE_CERTIFIED",
    "HORIZON_LIMITED",
    "QUARANTINED",
    "BLOCKED"
  ],
  "preservation": {
    "all_input_records_preserved": true,
    "shorter_history_records_not_deleted": true,
    "eligibility_assigned_per_horizon": true,
    "arbitrary_target_size_prohibited": true
  },
  "authority": {
    "historical_evidence_certification": true,
    "analytics_eligibility_assignment": true,
    "return_calculation": false,
    "risk_analytics": false,
    "forecasting": false,
    "ranking": false,
    "recommendations": false,
    "portfolio_allocation": false,
    "uip_export": false,
    "automatic_execution": false,
    "direct_uip_database_writes": false
  },
  "fail_closed": true
}
