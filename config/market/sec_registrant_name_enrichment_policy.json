{
  "policy_version": "1.0.0",
  "phase": "3.6b.3d.1",
  "required_full_population": 3462,
  "completed_pilot_count": 3,
  "source_tier": "SEC_SUBMISSIONS_API",
  "endpoint_template": "https://data.sec.gov/submissions/CIK{cik10}.json",
  "states": ["REGISTRANT_CONFIRMED", "REGISTRANT_UNRESOLVED", "REGISTRANT_CONFLICTED", "REGISTRANT_QUARANTINED", "PILOT_COMPLETE"],
  "controls": {
    "stable_security_id_required": true,
    "cik_required_for_collection": true,
    "sec_declared_user_agent_required": true,
    "raw_payload_preserved": true,
    "payload_sha256_required": true,
    "retrieval_timestamp_required": true,
    "returned_cik_must_match_requested_cik": true,
    "registrant_name_must_come_from_sec_name_field": true,
    "fund_name_as_registrant_prohibited": true,
    "ticker_or_name_inference_prohibited": true,
    "resume_safe_checkpoint_required": true,
    "failed_records_preserved": true,
    "no_destructive_deletion": true
  },
  "authority": {
    "sec_registrant_collection": true,
    "registrant_registry_build": true,
    "issuer_identity_ledger_rebuild": false,
    "issuer_batch_planning": false,
    "authoritative_source_capture": false,
    "production_taxonomy_classification": false,
    "production_taxonomy_certification": false,
    "benchmark_qualified_universe_publication": false,
    "relative_return_calculation": false,
    "risk_analytics": false,
    "forecasting": false,
    "ranking": false,
    "recommendations": false,
    "portfolio_allocation": false,
    "uip_export": false,
    "automatic_execution": false,
    "direct_uip_database_writes": false
  }
}
