{
  "phase": "3",
  "subphase": "3.6a",
  "policy_version": "1.0.0",
  "name": "Benchmark Taxonomy and Assignment Registry",
  "objective": "Assign benchmark classes and stable benchmark identities only when existing ETF taxonomy evidence supports the comparison, while preserving explicit unassigned, unsupported, and conflicted states.",
  "required_record_count": 3462,
  "uip_horizon_contract": ["30d", "90d", "180d", "1y", "3y", "5y"],
  "assignment_states": [
    "BENCHMARK_ASSIGNED",
    "BENCHMARK_UNASSIGNED",
    "BENCHMARK_UNSUPPORTED",
    "BENCHMARK_CONFLICTED"
  ],
  "supported_benchmark_classes": [
    "US_BROAD_EQUITY",
    "US_LARGE_CAP_EQUITY",
    "US_MID_CAP_EQUITY",
    "US_SMALL_CAP_EQUITY",
    "US_GROWTH_EQUITY",
    "US_VALUE_EQUITY",
    "US_DIVIDEND_EQUITY",
    "US_SECTOR_EQUITY",
    "INTERNATIONAL_DEVELOPED_EQUITY",
    "EMERGING_MARKETS_EQUITY",
    "GLOBAL_EQUITY",
    "US_AGGREGATE_BOND",
    "US_TREASURY_BOND",
    "US_CORPORATE_BOND",
    "US_HIGH_YIELD_BOND",
    "US_MUNICIPAL_BOND",
    "SHORT_DURATION_BOND",
    "REAL_ESTATE",
    "BROAD_COMMODITY",
    "PRECIOUS_METALS",
    "CURRENCY"
  ],
  "unsupported_specialized_product_types": [
    "LEVERAGED",
    "INVERSE",
    "LEVERAGED_INVERSE",
    "VOLATILITY",
    "BUFFER",
    "DEFINED_OUTCOME",
    "COVERED_CALL",
    "SINGLE_STOCK",
    "CRYPTO_LINKED",
    "ETN"
  ],
  "controls": {
    "stable_security_id_required": true,
    "stable_benchmark_security_id_required": true,
    "ticker_only_identity_prohibited": true,
    "classified_taxonomy_required": true,
    "taxonomy_conflicts_preserved": true,
    "unknown_taxonomy_must_not_be_inferred": true,
    "specialized_products_must_not_receive_standard_benchmark": true,
    "missing_benchmark_must_not_be_imputed": true,
    "self_benchmark_assignment_allowed": false,
    "all_input_records_preserved": true,
    "one_assignment_record_per_security": true,
    "assignment_does_not_imply_relative_return_availability": true
  },
  "authority": {
    "benchmark_taxonomy": true,
    "benchmark_assignment_registry": true,
    "relative_return_calculation": false,
    "risk_analytics": false,
    "forecasting": false,
    "ranking": false,
    "recommendations": false,
    "portfolio_allocation": false,
    "uip_export": false,
    "automatic_execution": false,
    "direct_uip_database_writes": false
  },
  "fail_closed": true
}
