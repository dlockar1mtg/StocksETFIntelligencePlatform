{
  "phase": "2",
  "subphase": "2B.2",
  "policy_version": "1.0.0",
  "provider_id": "YAHOO_FINANCE_CHART",
  "authority_level": "APPROVED_STRUCTURED",
  "source_status": "provisional",
  "endpoint_template": "https://query1.finance.yahoo.com/v8/finance/chart/{symbol}",
  "interval": "1d",
  "range": "18mo",
  "events": ["dividends", "splits"],
  "maximum_requests_per_second": 1,
  "timeout_seconds": 30,
  "retry_attempts": 4,
  "retry_backoff_seconds": [2, 5, 10, 20],
  "required_user_agent_environment_variable": "MARKET_DATA_USER_AGENT",
  "raw_evidence_immutable": true,
  "resumable": true,
  "preserve_all_input_records": true,
  "required_seed_symbols": ["VOO", "SCHD", "QQQM"],
  "selection_principle": "EVIDENCE_DETERMINES_SIZE",
  "target_universe_size": null,
  "fail_closed": true,
  "authority": {
    "recent_market_data_collection": true,
    "market_screen_development": true,
    "full_history_collection": false,
    "analytics": false,
    "forecasting": false,
    "ranking": false,
    "recommendations": false,
    "portfolio_allocation": false,
    "uip_export": false,
    "automatic_execution": false,
    "direct_uip_database_writes": false
  }
}
