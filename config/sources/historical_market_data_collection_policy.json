{
  "phase": "3",
  "subphase": "3.2",
  "policy_version": "1.0.1",
  "name": "Historical Market Data Collector",
  "objective": "Collect immutable full-history daily market evidence for the 3462 certified Phase 3 ETF candidates without authorizing computed returns or risk analytics.",
  "required_candidate_count": 3462,
  "required_candidate_state": "MARKET_DATA_ELIGIBLE",
  "provisional_candidates_allowed": false,
  "required_seed_symbols": ["VOO", "SCHD", "QQQM"],
  "provider_id": "YAHOO_FINANCE_CHART",
  "endpoint_template": "https://query1.finance.yahoo.com/v8/finance/chart/{symbol}",
  "interval": "1d",
  "period1": 0,
  "period2": 2147483647,
  "range_parameter_prohibited": true,
  "required_provider_data_granularity": "1d",
  "events": ["div", "splits"],
  "include_adjusted_close": true,
  "timeout_seconds": 30,
  "retry_attempts": 4,
  "retry_backoff_seconds": [2, 5, 10],
  "minimum_seconds_between_requests": 1.0,
  "progress_interval_records": 100,
  "checkpoint_required": true,
  "resumable": true,
  "retry_failed_supported": true,
  "raw_payloads_immutable": true,
  "terminal_statuses": ["COLLECTED", "NOT_FOUND", "SYMBOL_MISMATCH", "GRANULARITY_MISMATCH", "PROVIDER_ERROR", "INVALID_SYMBOL"],
  "retryable_statuses": ["PROVIDER_ERROR"],
  "pilot": {
    "required": true,
    "symbols": ["VOO", "SCHD", "QQQM"],
    "full_universe_collection_authorized_before_pilot_review": false
  },
  "authority": {
    "historical_data_collection": true,
    "historical_data_normalization": true,
    "return_calculation": false,
    "risk_analytics": false,
    "forecasting": false,
    "ranking": false,
    "recommendations": false,
    "portfolio_allocation": false,
    "uip_export": false,
    "automatic_execution": false,
    "direct_uip_database_writes": false
  },
  "fail_closed": true
}
