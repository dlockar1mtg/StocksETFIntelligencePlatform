{
  "version": "1.0.0",
  "phase": "1.1",
  "fail_closed": true,
  "unknown_providers_blocked": true,
  "undeclared_domains_blocked": true,
  "secrets_must_remain_outside_git": true,
  "raw_payloads_must_remain_outside_git": true,
  "required_provider_fields": [
    "provider_id",
    "provider_version",
    "source_tier",
    "license_class",
    "supported_domains",
    "retrieved_at_utc",
    "as_of_date",
    "content_sha256"
  ],
  "required_observation_fields": [
    "security_id",
    "domain",
    "source_record_id",
    "observed_at_utc",
    "retrieved_at_utc",
    "as_of_date",
    "content_sha256",
    "quality_status",
    "freshness_state"
  ],
  "governed_domains": [
    "raw_price",
    "adjusted_price",
    "distribution",
    "corporate_action",
    "etf_metadata",
    "holdings",
    "expense_ratio",
    "assets_under_management",
    "liquidity",
    "benchmark"
  ],
  "allowed_source_tiers": [1, 2, 3, 4, 5],
