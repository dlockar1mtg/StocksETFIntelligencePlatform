  "critical_conflicts_must_be_quarantined": true,
  "missing_required_fields_block_observation": true,
  "future_observations_blocked": true,
  "ticker_only_identity_blocked": true,
  "provider_adjusted_values_require_reconciliation": true,
  "direct_uip_database_writes_authorized": false,
  "certified_market_monitoring_authorized": false,
  "certified_analytics_authorized": false
