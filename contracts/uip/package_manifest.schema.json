{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uip.package_manifest/1.0.0",
  "title": "UIP Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "domain", "contract_version", "generated_at_utc", "source_snapshot_id", "repository_commit", "files", "validation_status", "certification_status", "automatic_execution_authorized"],
  "properties": {
    "package_id": {"type": "string", "minLength": 8},
    "domain": {"const": "stocks_etf"},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generated_at_utc": {"type": "string"},
    "source_snapshot_id": {"type": "string", "minLength": 1},
    "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256", "row_count"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "row_count": {"type": "integer", "minimum": 0}}},
    "validation_status": {"enum": ["PASS", "PASS_WITH_LIMITATIONS", "FAIL"]},
    "certification_status": {"enum": ["RESEARCH_ONLY", "SHADOW", "PROVISIONAL", "CERTIFIED", "BLOCKED"]},
    "automatic_execution_authorized": {"const": false}
  }
}
