{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native.etf_structural_triage_record/1.0.0",
  "title": "ETF Structural Triage Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "security_id",
    "symbol",
    "broker_status",
    "instrument_structure",
    "strategy_family",
    "specialized_flags",
    "fund_status",
    "inception_date",
    "history_depth_days",
    "liquidity_status",
    "identity_quality_status",
    "evidence_quality_status",
    "conflict_status",
    "triage_state",
    "reason_codes",
    "cost_tier",
    "observed_at_utc",
    "effective_date",
    "source_lineage",
    "authority"
  ],
  "properties": {
    "security_id": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "broker_status": {"enum": ["ELIGIBLE", "PURCHASE_RESTRICTED", "SELL_ONLY", "TEMPORARILY_UNAVAILABLE", "DELISTED", "UNKNOWN", "CONFLICTED"]},
    "instrument_structure": {"enum": ["ETF", "ETN", "CEF", "TRUST", "PARTNERSHIP", "OTHER", "UNKNOWN"]},
    "strategy_family": {"type": ["string", "null"]},
    "benchmark_id": {"type": ["string", "null"]},
    "issuer_id": {"type": ["string", "null"]},
    "specialized_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "fund_status": {"enum": ["ACTIVE", "CLOSING", "LIQUIDATING", "DELISTED", "UNKNOWN", "CONFLICTED"]},
    "inception_date": {"type": ["string", "null"], "format": "date"},
    "history_depth_days": {"type": ["integer", "null"], "minimum": 0},
    "median_daily_dollar_volume": {"type": ["number", "null"], "minimum": 0},
    "median_bid_ask_spread_bps": {"type": ["number", "null"], "minimum": 0},
    "aum_usd": {"type": ["number", "null"], "minimum": 0},
    "expense_ratio": {"type": ["number", "null"], "minimum": 0},
    "holdings_transparency_status": {"enum": ["CURRENT", "LAGGED", "OPAQUE", "NOT_APPLICABLE", "UNKNOWN", "CONFLICTED"]},
    "liquidity_status": {"enum": ["PASS", "PROVISIONAL", "RESTRICTED", "BLOCKED", "UNKNOWN", "CONFLICTED"]},
    "identity_quality_status": {"enum": ["PASS", "PROVISIONAL", "QUARANTINED", "BLOCKED"]},
    "evidence_quality_status": {"enum": ["PASS", "PROVISIONAL", "INSUFFICIENT", "STALE", "CONFLICTED", "BLOCKED"]},
    "conflict_status": {"enum": ["NONE", "RESOLVED", "UNRESOLVED_NONCRITICAL", "UNRESOLVED_CRITICAL"]},
    "triage_state": {"enum": ["STRUCTURAL_CANDIDATE", "DATA_COLLECTION_CANDIDATE", "ANALYTICS_PROVISIONAL", "SPECIALIZED", "PORTFOLIO_RESTRICTED", "RESEARCH_ONLY", "QUARANTINED", "BLOCKED"]},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "cost_tier": {"enum": ["TIER_0_REFERENCE", "TIER_1_STRUCTURAL", "TIER_2_MARKET_SCREEN", "TIER_3_COMPARATIVE_ANALYTICS", "TIER_4_APPROVED"]},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "effective_date": {"type": "string", "format": "date"},
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "dataset_id", "source_record_id", "retrieved_at_utc", "observed_at_utc", "authority_level", "source_status", "license_class", "content_sha256"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "dataset_id": {"type": "string", "minLength": 1},
          "source_record_id": {"type": "string", "minLength": 1},
          "retrieved_at_utc": {"type": "string", "format": "date-time"},
          "observed_at_utc": {"type": "string", "format": "date-time"},
          "effective_date": {"type": ["string", "null"], "format": "date"},
          "revision_date": {"type": ["string", "null"], "format": "date"},
          "authority_level": {"enum": ["PRIMARY_OFFICIAL", "APPROVED_STRUCTURED_PROVIDER", "DERIVED_PLATFORM", "SUPPLEMENTAL_RESEARCH"]},
          "source_status": {"enum": ["research_only", "provisional", "certified", "deprecated", "blocked"]},
          "license_class": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analytics_authorized", "recommendations_authorized", "uip_export_authorized", "automatic_execution_authorized"],
      "properties": {
        "analytics_authorized": {"const": false},
        "recommendations_authorized": {"const": false},
        "uip_export_authorized": {"const": false},
        "automatic_execution_authorized": {"const": false}
      }
    }
  }
}
