{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native.etf_structural_metadata_record/1.0.0",
  "title": "ETF Structural Metadata Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "security_id", "symbol", "fund_name", "issuer_name", "instrument_structure",
    "fund_status", "inception_date", "strategy_description", "benchmark_name",
    "expense_ratio", "aum_usd", "specialized_flags", "observed_at_utc",
    "effective_date", "source_lineage", "record_status", "conflict_fields", "authority"
  ],
  "properties": {
    "security_id": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "fund_name": {"type": ["string", "null"]},
    "issuer_name": {"type": ["string", "null"]},
    "instrument_structure": {"enum": ["ETF", "ETN", "CEF", "TRUST", "PARTNERSHIP", "OTHER"]},
    "fund_status": {"enum": ["ACTIVE", "CLOSING", "LIQUIDATING", "DELISTED", "UNKNOWN"]},
    "inception_date": {"type": ["string", "null"], "format": "date"},
    "strategy_description": {"type": ["string", "null"]},
    "benchmark_name": {"type": ["string", "null"]},
    "expense_ratio": {"type": ["number", "null"], "minimum": 0},
    "aum_usd": {"type": ["number", "null"], "minimum": 0},
    "specialized_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "effective_date": {"type": "string", "format": "date"},
    "source_lineage": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "record_status": {"enum": ["COMPLETE", "PARTIAL", "CONFLICTED", "QUARANTINED", "BLOCKED"]},
    "conflict_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analytics_authorized", "recommendations_authorized", "uip_export_authorized", "automatic_execution_authorized"],
      "properties": {
        "analytics_authorized": {"const": false},
        "recommendations_authorized": {"const": false},
        "uip_export_authorized": {"const": false},
        "automatic_execution_authorized": {"const": false}
      }
    }
  }
}
