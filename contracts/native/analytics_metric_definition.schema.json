{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native.analytics_metric_definition/1.0.0",
  "title": "ETF Analytics Metric Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["metric_id","pillar","value_type","direction","required_domains","supported_horizons","minimum_observations","formula_version","benchmark_required"],
  "properties": {
    "metric_id": {"type":"string","pattern":"^[a-z][a-z0-9_]*$"},
    "pillar": {"enum":["RETURN_TREND","RISK_DRAWDOWN","VALUATION_FUNDAMENTALS","INCOME_DISTRIBUTIONS","FUND_STRUCTURE","DIVERSIFICATION_OVERLAP","REGIME_PORTFOLIO_FIT"]},
    "value_type": {"enum":["DECIMAL","CURRENCY","INTEGER","BOOLEAN","CATEGORY"]},
    "direction": {"enum":["HIGHER_IS_BETTER","LOWER_IS_BETTER","CONTEXT_DEPENDENT","INFORMATIONAL"]},
    "required_domains": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "supported_horizons": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["POINT_IN_TIME","1M","3M","1Y","3Y","5Y"]}},
    "minimum_observations": {"type":"integer","minimum":1},
    "formula_version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "benchmark_required": {"type":"boolean"}
  }
}
